<!--
    node/1 should be tagged as orphan
    node/2 should be tagged as duplicate orphan
    node/3 should be tagged as duplicate orphan
    node/4 should be tagged as duplicate
    node/5 should be anonymous
-->
<osm version="0.6" generator="geodesk-gol-test">
    <node id="1" version="1" lon="-90" lat="45"/>
    <node id="2" version="1" lon="90" lat="45"/>
    <node id="3" version="1" lon="90" lat="45"/>
    <node id="4" version="1" lon="90" lat="45"/>
    <node id="5" version="1" lon="90" lat="-45"/>
    <way id="1" version="1">
        <nd ref="4"/>
        <nd ref="5"/>
    </way>
</osm>